# Chronolog Production Environment
# Copy to .env.prod and fill in real values before deploying.
# Start with: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --- Required secrets (generate with: openssl rand -base64 32) ---
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# --- App URL (must match your domain/port) ---
BETTER_AUTH_URL=https://your-domain.com
VITE_POWERSYNC_URL=https://your-domain.com:8080

# --- Optional overrides ---
# APP_PORT=3000
# POSTGRES_USER=chronolog
# POSTGRES_DB=chronolog
# POWERSYNC_PORT=8080
# BUCKET_STORAGE_PASSWORD=
# PS_REPL_USER=powersync_repl
# PS_REPL_PASSWORD=powersync_repl_password
