# Chronolog production environment — read by docker-compose.prod.yml via --env-file.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   then fill in the values below. scripts/deploy-prod.sh refuses to run without .env.prod.
#
# .env.prod is gitignored (.env.*) and excluded from the Docker build context (.dockerignore).
# Never commit it, paste it into a chat, or print it in logs.

# --- Secrets (required; generate each one separately) ---
# ENCRYPTION_KEY encrypts data at rest. Losing it makes encrypted fields unreadable, and backups
# are only restorable with the key that was live when they were taken: keep a copy off the box
# (password manager). Rotating it is not supported yet.
#   openssl rand -base64 32
ENCRYPTION_KEY=
# Session signing secret. Rotating it signs everyone out.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Database password. Hex so it is safe inside DATABASE_URL without URL-encoding. Only applied when
# the Postgres volume is first created; changing it later needs ALTER USER inside the container.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Public URL ---
# The origin browsers use. Better Auth base URL and trusted origin, and (unless ORIGIN is set)
# adapter-node's CSRF origin for form actions.
BETTER_AUTH_URL=https://chronolog.throb.online
# Override only if the CSRF origin must differ from BETTER_AUTH_URL.
# ORIGIN=https://chronolog.throb.online

# Comma-separated extra origins Better Auth accepts sign-in from (e.g. the Tauri app origin).
TRUSTED_ORIGINS=

# --- Registration ---
# Closed by default. Set to true only while creating the first account, then back to false and
# re-run scripts/deploy-prod.sh (see docs/DEPLOYMENT.md, "First account").
ALLOW_REGISTRATION=false

# --- Optional overrides (defaults shown) ---
# APP_PORT=3123          # host port, bound to 127.0.0.1 only; see docs/ports.md
# POSTGRES_USER=chronolog
# POSTGRES_DB=chronolog
