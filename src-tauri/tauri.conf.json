{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronolog",
  "version": "../package.json",
  "identifier": "com.chronolog.app",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Time tracking and notes for consulting work",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  }
}
