DATABASE_URL=postgresql://chronolog:chronolog@localhost:5432/chronolog

# REQUIRED — the app refuses to boot without these (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-256-bit-encryption-key-here
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

BETTER_AUTH_URL=http://localhost:5173

# registration is closed unless this is true
ALLOW_REGISTRATION=true

# comma-separated extra origins allowed by Better Auth (e.g. a Tailscale IP)
TRUSTED_ORIGINS=
