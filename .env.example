DATABASE_URL=postgresql://chronolog:chronolog@localhost:5432/chronolog

# REQUIRED — the app refuses to boot without these
# ENCRYPTION_KEY must be the output of `openssl rand -base64 32` (base64 of exactly 32 bytes;
# validated at boot). Leave it empty until generated; never reuse a shared or example value.
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

BETTER_AUTH_URL=http://localhost:5173

# Device access key gate. Unset in development disables the gate (the app logs a loud warning at
# boot); production requires it. Generate with `node scripts/generate-device-key.mjs` (Node 22.18+)
# and paste only the DEVICE_ACCESS_KEY_HASH line here. The raw DEVICE_ACCESS_KEY goes in the
# password manager, never in this file.
# DEVICE_ACCESS_KEY_HASH=

# registration is closed unless this is true
ALLOW_REGISTRATION=true

# comma-separated extra origins allowed by Better Auth (e.g. a Tailscale IP)
TRUSTED_ORIGINS=
